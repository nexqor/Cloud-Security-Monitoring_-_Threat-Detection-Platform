# --- App ---
APP_ENV=development
SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# Use sqlite for local dev, postgres for prod:
# DATABASE_URL=postgresql://user:password@localhost:5432/cloudshield
DATABASE_URL=sqlite:///./cloudshield.db

# --- AWS ---
# Leave blank to fall back to the default boto3 credential chain
# (~/.aws/credentials, instance role, SSO profile, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1

# --- Alerting ---
SNS_TOPIC_ARN=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
